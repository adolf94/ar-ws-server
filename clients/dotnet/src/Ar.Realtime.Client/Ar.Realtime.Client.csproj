<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>Publisher client for the realtime microservice (HTTP server API — publish/broadcast/unicast/group ops, Cloudflare-safe User-Agent, ar-auth token integration). Contract: docs/CONTRACT.md v1.</Description>
    <Authors>adolfrey</Authors>
    <Version>0.1.0-local</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageId>Ar.Realtime.Client</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <!-- 1.2.1 = published GitHub Packages artifact (adolf94/ar-oauth2) — same
         source tree as the former 1.2.0-local pin, same lineage CI stages
         into the auth-feed (publish workflow) or ../local-nuget (dev). -->
    <PackageReference Include="Ar.Auth.OpenId" Version="1.2.1" />
  </ItemGroup>
</Project>
