<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Realtime server (successor of the Centrifugo + proxy-wall stack).
    See ../../centrifugo/docs/PLAN-OWN-SERVER.md for the design:
      - one process: SignalR hub (bus) + minimal API (server API)
      - negotiate middleware issues a short-lived, server-signed connection
        token into the NEGOTIATE RESPONSE's accessToken field (§5.2)
      - IdP tokens are verified via Ar.Auth.OpenId (VerifyTokenAsync)
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Realtime</RootNamespace>
    <!-- Ar.Auth.OpenId pin: dev consumes the locally built 1.2.0-local (vendored into
         nuget-feed/ by dev/build-image.sh); the CI container build overrides this at
         restore time with the published GitHub Packages artifact (see Dockerfile). -->
    <ArAuthOpenIdVersion>1.2.0-local</ArAuthOpenIdVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- hub-side connection-token scheme (HS256, ?access_token query-or-header) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- IdP token verification: docs/INTEGRATION.md's official IdP client -->
    <PackageReference Include="Ar.Auth.OpenId" Version="$(ArAuthOpenIdVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>
</Project>
