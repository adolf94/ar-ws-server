<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- container build config: same two sources as the repo, but the
         sibling-repo artifact comes from the VENDORED feed copied into
         the image at /nuget-feed (see Dockerfile + dev/build-image.sh) -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-nuget" value="/nuget-feed" />
  </packageSources>
</configuration>
